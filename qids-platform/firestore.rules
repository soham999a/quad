rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role helpers read directly from the user doc — no recursive get()
    // needed because /users allow read when isOwner is true (self-read).
    function hasRole(role) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdmin()     { return hasRole('admin'); }
    function isEvaluator() { return hasRole('evaluator'); }
    function isTeacher()   { return hasRole('teacher'); }

    // Personas are self-declared (they choose the audience shell).
    // 'admin' is privileged and may only be granted by another admin.
    function isSelfRoleSelection() {
      return (resource.data.role == 'individual' || !('role' in resource.data))
        && request.resource.data.role in ['individual', 'student', 'teacher', 'evaluator', 'employer'];
    }

    // Plan is a billing field: clients may keep it unchanged but never set it.
    // Exception: a profile created before the plan field existed (or by signup,
    // which omits it) may initialize it to 'free' exactly once — anything else
    // (paid tiers) stays server-only.
    // (Server / billing integration writes plans in a later phase.)
    function planUnchanged() {
      return request.resource.data.plan == resource.data.plan
        || (!('plan' in resource.data) && request.resource.data.plan == 'free');
    }

    // ── Users (profiles) ───────────────────────────────────────────────────
    // Self-read is required so the role helpers above can resolve.
    // SECURITY: clients cannot escalate their own role to 'admin' and cannot
    // grant themselves a paid plan. Admin grants go through an existing admin.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.role != 'admin'
            && (!('plan' in request.resource.data) || request.resource.data.plan == 'free'));
      allow update: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.role == resource.data.role
            && planUnchanged())
        || (isOwner(userId) && isSelfRoleSelection() && planUnchanged());
      allow delete: if isAdmin();
    }

    // ── Onboarding ──────────────────────────────────────────────────────────
    // Progress + completion marker. The wizard writes and the gate reads this
    // doc; without this rule every onboarding write/read is denied, which bounces
    // freshly-onboarded users straight back to /onboarding instead of the shell.
    match /onboarding/{uid} {
      allow read, write: if isOwner(uid);
    }

    // ── Assessment checkpoints ─────────────────────────────────────────────
    // Cross-device resume state ({uid}_{kind} ids). Owner-only, like onboarding.
    match /assessmentCheckpoints/{docId} {
      allow read, write: if isSignedIn() && docId.split('_')[0] == request.auth.uid;
    }

    // ── Public evaluator directory ─────────────────────────────────────────
    // Minimal directory entries ({ uid, name, email }) written by evaluators
    // themselves, readable by any signed-in user. This replaces the old
    // getAllUsers() lookup that permission-denied for non-admins.
    match /publicEvaluators/{evaluatorUid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(evaluatorUid)
        && request.resource.data.uid == evaluatorUid;
      allow delete: if isOwner(evaluatorUid) || isAdmin();
    }

    // ── Assessments ─────────────────────────────────────────────────────────
    // Evaluators may read assessments of students assigned to them, so the
    // evaluator console works under least-privilege rules.
    match /assessments/{assessmentId} {
      allow read: if isOwner(resource.data.uid) || isAdmin()
        || (isEvaluator()
            && exists(/databases/$(database)/documents/evaluatorAssignments/$(request.auth.uid + '_' + resource.data.uid)));
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(resource.data.uid) || isAdmin();
      allow delete: if isOwner(resource.data.uid) || isAdmin();
    }

    // ── Public credentials (shareable /credential/:id) ─────────────────────
    // Sanitised, user-published snapshots of a completed assessment:
    // { uid, assessmentId, name, unifiedScore, grade, pillarScores, skillShape,
    //   issuedAt, hash }. Readable by anyone (that's the point); writable only
    // by the profile owner.
    // Creates are shape-validated (bounded strings, numeric scores, fixed
    // surface) and the credential is immutable once issued: no updates, so a
    // published result can never silently change after the fact.
    function isValidCredential() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.assessmentId is string
        && request.resource.data.assessmentId.size() > 0
        && request.resource.data.assessmentId.size() <= 128
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && (!('unifiedScore' in request.resource.data) || request.resource.data.unifiedScore is number)
        && (!('grade' in request.resource.data) || request.resource.data.grade is string)
        && (!('skillShape' in request.resource.data) || request.resource.data.skillShape is string)
        && (!('pillarScores' in request.resource.data)
            || (request.resource.data.pillarScores is map
                && request.resource.data.pillarScores.size() <= 8));
    }
    match /publicCredentials/{credId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidCredential();
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ── Reports ─────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(resource.data.uid) || isAdmin();
      allow delete: if isOwner(resource.data.uid) || isAdmin();
    }

    // ── Intervention Plans ──────────────────────────────────────────────────
    match /interventionPlans/{planId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(resource.data.uid) || isAdmin();
      allow delete: if isOwner(resource.data.uid) || isAdmin();
    }

    // ── Kids 4Q Practice ────────────────────────────────────────────────────
    // Child sub-profiles under a guardian/teacher account: no separate child
    // login exists, so every document is owned by the signed-in adult's uid.
    // Profiles are bounded strings only, and creation requires a recorded
    // guardian attestation — this is a child's personal data.
    match /kidsProfiles/{childId} {
      allow read, update, delete: if isOwner(resource.data.uid) || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 8
        && request.resource.data.ageBand in ['8-10', '11-14']
        && request.resource.data.consent is map
        && request.resource.data.consent.attestedAt is string
        && request.resource.data.consent.version is string;
    }

    // Progress parent doc: only the single in-progress chapter is mutable.
    // The doc id is pinned to `<uid>_<childId>` so one account cannot address
    // another family's log.
    match /kidsProgress/{docId} {
      allow read, update, delete: if isOwner(resource.data.uid) || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && docId == request.auth.uid + '_' + request.resource.data.childId;

      // Finished chapters are immutable: created once, never rewritten. That
      // is what keeps a practice record honest without a server in the loop.
      // Delete stays available to the owner for erasure requests.
      match /sessions/{sessionId} {
        allow read:
          if isOwner(get(/databases/$(database)/documents/kidsProgress/$(docId)).data.uid)
          || isAdmin();
        allow create: if isSignedIn()
          && get(/databases/$(database)/documents/kidsProgress/$(docId)).data.uid == request.auth.uid
          && sessionId == request.resource.data.id
          && request.resource.data.completedAt is string
          && request.resource.data.chapterId is string
          && request.resource.data.choices is list
          && request.resource.data.choices.size() <= 20;
        allow update: if false;
        allow delete:
          if isOwner(get(/databases/$(database)/documents/kidsProgress/$(docId)).data.uid)
          || isAdmin();
      }
    }

    // ── Evaluator Assignments ──────────────────────────────────────────────
    match /evaluatorAssignments/{assignmentId} {
      allow read: if isSignedIn() && (
        resource.data.evaluatorUid == request.auth.uid ||
        resource.data.studentUid == request.auth.uid ||
        isAdmin()
      );
      // A person choosing their own evaluator (self-link) is the normal path
      // for individuals and students; an evaluator/admin assigning someone
      // else stays allowed. `studentName` is the display name carried on the
      // assignment so the evaluator console can show who they are looking
      // after — /users is owner-or-admin read only, by design.
      allow create: if (isSignedIn() && request.resource.data.studentUid == request.auth.uid)
        || isEvaluator() || isAdmin();
      // Two distinct writers, one statement:
      //  - the evaluator/admin who owns the pairing,
      //  - the person it is ABOUT. The second used to be missing, so a person
      //    who picked their own evaluator could never undo it — `removeAssignment`
      //    writes `active: false` as an update, and update required evaluator or
      //    admin. The write is pinned: identities may not change and `active` must
      //    stay a bool, so all this grants is link/unlink of their OWN pairing.
      //    Reactivation is deliberately included, because `assignEvaluator` uses
      //    setDoc — on an existing doc that is an update, so re-picking someone
      //    you unlinked has to pass the same rule.
      allow update: if isEvaluator() || isAdmin()
        || (isSignedIn()
            && resource.data.studentUid == request.auth.uid
            && request.resource.data.evaluatorUid == resource.data.evaluatorUid
            && request.resource.data.studentUid == resource.data.studentUid
            && request.resource.data.active is bool);
      allow delete: if isAdmin();
    }

    // ── Evaluations ─────────────────────────────────────────────────────────
    match /evaluations/{evaluationId} {
      allow read: if isSignedIn() && (
        resource.data.evaluatorUid == request.auth.uid ||
        resource.data.studentUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isEvaluator() || isAdmin();
      allow update: if (isEvaluator() && resource.data.evaluatorUid == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Enterprise Results ─────────────────────────────────────────────────
    match /enterpriseResults/{resultId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(resource.data.uid) || isAdmin();
      allow delete: if isOwner(resource.data.uid) || isAdmin();
    }

    // ── Server scoring shadow records (pre-1.1, superseded) ────────────────
    // Kept denied so historical shadow documents stay opaque. New submissions
    // go to assessmentRecords below.
    match /scoringShadow/{submissionId} {
      allow read, write: if false;
    }

    // ── Server-scored submissions ──────────────────────────────────────────
    // The audit trail: item-level answers, derived scores, input hash. Written
    // only by /api/submit-assessment through the Admin SDK, so a client can
    // neither read its own answers back nor forge a score. Nothing in the app
    // needs client access — the credential reads via /api/verification.
    match /assessmentRecords/{submissionId} {
      allow read, write: if false;
    }

    // The compact summary a credential is checked against. Also Admin-only:
    // /api/verification decides who may see it (owner, or anyone once the
    // credential is published) and strips the uid before responding.
    match /assessmentVerifications/{assessmentId} {
      allow read, write: if false;
    }

    // ── Product analytics (funnel events) ──────────────────────────────────
    // Create-only for any signed-in user (append-only telemetry: users can add
    // their own events but never read anyone's or modify existing ones).
    // Validation keeps the shape tight: known event names, bounded props.
    match /analytics_events/{eventId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && (!('props' in request.resource.data) || request.resource.data.props.size() <= 10);
      allow update, delete: if false;
    }

    // ── Interview Sessions ─────────────────────────────────────────────────
    // Two-party instrument: the evaluator scores, the candidate preps and
    // self-assesses. Access is member-only (the named parties or admin), and
    // once the candidate is a real platform user their update surface is
    // field-scoped so a candidate can never write their own scores.
    match /interviewSessions/{sessionId} {
      function isInterviewCandidate() {
        return isSignedIn() && resource.data.candidateUid == request.auth.uid;
      }
      function isInterviewEvaluator() {
        return isSignedIn() && (resource.data.evaluatorUid == request.auth.uid || isAdmin());
      }
      // Completed interviews are frozen for BOTH parties — the same
      // immutability principle as publicCredentials / schoolAttempts: a
      // published result can never silently change after the fact.
      function interviewCompleted() { return resource.data.status == 'completed'; }

      allow read: if isInterviewCandidate() || isInterviewEvaluator();
      allow create: if isSignedIn() && (
        request.resource.data.evaluatorUid == request.auth.uid ||
        request.resource.data.candidateUid == request.auth.uid
      );
      // Field discipline:
      //  - Candidate: their own prep surface only — self-assessment, typed
      //    responses, and the ready-up gate transitions (invited → accepted /
      //    declined). Never evaluatorAssessment, scores or status as data.
      //  - Evaluator (or admin): the scoring surface, but never re-binding
      //    the two parties mid-flight, and never stepping over the candidate's
      //    ready-up gate (can't force in_progress before the candidate
      //    accepted; cancelling an un-accepted invite stays allowed).
      //  - Completed: frozen for everyone.
      allow update: if isSignedIn() && !interviewCompleted() && (
        (isInterviewCandidate()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'selfAssessment', 'candidateResponses',
            'candidateAcceptedAt', 'candidateDeclinedAt',
            // WebRTC signalling: the candidate owns exactly these two fields —
            // the answer to the evaluator's offer and their own ICE trickle.
            // Offers and evaluator ICE stay evaluator-only, below.
            'webrtcAnswer', 'webrtcCandIce',
            // updateInterviewSession always stamps updatedAt; it is a server
            // bookkeeping field, never a scoring one, so it stays allowed.
            'updatedAt'
          ])
          && ((request.resource.data.status == resource.data.status)
              || (request.resource.data.status == null)
              || (resource.data.status == 'invited'
                  && request.resource.data.status in ['accepted', 'declined'])))
        || (isInterviewEvaluator()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['candidateUid', 'evaluatorUid'])
          && ((resource.data.status != 'invited')
              || (request.resource.data.status == null)
              || (request.resource.data.status == resource.data.status)
              || (request.resource.data.status == 'cancelled')
              || resource.data.candidateAcceptedAt != null))
      );
      // Deleting a scoring record is the recorder's or an admin's call — not
      // the candidate's.
      allow delete: if isInterviewEvaluator();
    }

    // ── School Classes ─────────────────────────────────────────────────────
    // Read stays signed-in-wide: students join by 6-char class code, which is
    // the capability secret. Writes are restricted to the owning teacher.
    match /schoolClasses/{classId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.teacherUid == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.teacherUid == request.auth.uid || isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.teacherUid == request.auth.uid || isAdmin()
      );
    }

    // ── Class Students ─────────────────────────────────────────────────────
    // Students join rosters themselves; the class teacher and admins manage.
    match /classStudents/{entryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.studentUid == request.auth.uid ||
        isAdmin() ||
        get(/databases/$(database)/documents/schoolClasses/$(request.resource.data.classId)).data.teacherUid == request.auth.uid
      );
      allow update: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid ||
        isAdmin() ||
        get(/databases/$(database)/documents/schoolClasses/$(resource.data.classId)).data.teacherUid == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid ||
        isAdmin() ||
        get(/databases/$(database)/documents/schoolClasses/$(resource.data.classId)).data.teacherUid == request.auth.uid
      );
    }

    // ── School Assessments ─────────────────────────────────────────────────
    match /schoolAssessments/{assessmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.teacherUid == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.teacherUid == request.auth.uid || isAdmin()
      );
    }

    // Student completion records for assigned assessments — append-only.
    // Students may only create attempts bearing their own uid; the attempt
    // carries teacherUid/classId so teachers can read their class's attempts.
    match /schoolAttempts/{attemptId} {
      allow read: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid ||
        resource.data.teacherUid == request.auth.uid ||
        isAdmin()
      );
      // Shape-validated creates: an attempt must carry a real class, teacher
      // and assignment reference so the append-only roster can't be polluted
      // with junk documents from a scripted client.
      allow create: if isSignedIn() &&
        request.resource.data.studentUid == request.auth.uid &&
        request.resource.data.teacherUid is string &&
        request.resource.data.teacherUid.size() > 0 &&
        request.resource.data.classId is string &&
        request.resource.data.classId.size() > 0 &&
        request.resource.data.schoolAssessmentId is string &&
        request.resource.data.schoolAssessmentId.size() > 0 &&
        (!('studentName' in request.resource.data) ||
          (request.resource.data.studentName is string &&
           request.resource.data.studentName.size() <= 80));
      allow update, delete: if false;
    }

    // ── In-app notifications ─────────────────────────────────────────────
    // Per-user bell feed. Users read/mark their own; creation is allowed for
    // any signed-in user because peers legitimately notify peers (student →
    // teacher on join, student → evaluator on assignment). Creates are
    // shape-validated and bounded so the feed can't be used as a spam/junk
    // sink; rules pin read/mark to the recipient.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.uid is string &&
        request.resource.data.uid.size() > 0 &&
        request.resource.data.uid.size() <= 128 &&
        request.resource.data.type is string &&
        request.resource.data.type.size() <= 24 &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 120 &&
        (!('body' in request.resource.data) ||
          (request.resource.data.body is string && request.resource.data.body.size() <= 280)) &&
        (!('link' in request.resource.data) ||
          (request.resource.data.link is string && request.resource.data.link.size() <= 200));
      allow update: if isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // ── Error reports (ops) ──────────────────────────────────────────────
    // Written exclusively by the /api/log-error Admin SDK endpoint (which
    // bypasses rules); admins read the latest reports in the Admin Panel.
    match /errorReports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }

}
