# ── Required (client Firebase config — public by design) ──────────────────────
# Firebase web app config. These are NOT secrets (Firebase web API keys are
# identifiers, restricted via Google Cloud → APIs & Services → Credentials).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Server-only secrets (Vercel env vars — NEVER prefix with VITE_) ──────────
# Groq API key for the /api/generate-questions proxy. Server-side only; a
# VITE_-prefixed copy would ship in the public JS bundle. Do not set both.
GROQ_API_KEY=
# Firebase project id used by the /api/* functions for Admin SDK + token auth.
FIREBASE_PROJECT_ID=
# Vercel: add a Google Applications Default credential json to these:
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# (or provide GOOGLE_APPLICATION_CREDENTIALS pointing at a service-account json)

# ── Optional tuning ───────────────────────────────────────────────────────────
# Per-user AI generations per hour through the proxy (default 30).
GROQ_RATE_LIMIT_PER_HOUR=30
# Error-report batches per minute per IP for /api/log-error (default 20).
ERROR_RATE_LIMIT_PER_MINUTE=20
# Set to "true" (not "1") on Vercel to enable App Check enforcement on /api/*.
# Requires setting up App Check with the reCAPTCHA Enterprise (v2) provider in
# the Firebase console and the VITE_RECAPTCHA_SITE_KEY in the client env.
VERCEL_APPCHECK_ENFORCE=true
# reCAPTCHA Enterprise site key for App Check (client-side, public by design).
VITE_RECAPTCHA_SITE_KEY=

# ── E2E-only (never in production) ────────────────────────────────────────────
E2E_RUN=
